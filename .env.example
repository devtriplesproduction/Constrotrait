# Supabase Configuration
# Connect your Supabase project credentials.
# Note: The publishable key is safe for client-side exposure.
# NEVER expose SUPABASE_SERVICE_ROLE_KEY or secret keys to client-side code.

NEXT_PUBLIC_SUPABASE_URL=https://<YOUR_SUPABASE_URL>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<YOUR_SUPABASE_PUBLISHABLE_KEY>
SUPABASE_DB_PASSWORD=<YOUR_SUPABASE_DB_PASSWORD>
SUPABASE_PUBLISHABLE_KEY_EXTRA=<YOUR_SUPABASE_PUBLISHABLE_KEY_EXTRA>