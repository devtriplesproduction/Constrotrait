# Supabase Configuration
# Connect your Supabase project credentials.
# Note: The publishable key is safe for client-side exposure.
# NEVER expose SUPABASE_SERVICE_ROLE_KEY or secret keys to client-side code.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
